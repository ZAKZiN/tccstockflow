{
    "version": 2,
    "builds": [
        {
            "src": "public/index.php",
            "use": "vercel-community/php@0.4.3"
        }
    ],
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.php"
        }
    ]
}
